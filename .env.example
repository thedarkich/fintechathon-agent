# Copy to .env for local development. Never commit the copy. Variable names match backend/app/config.py.

# --- AI planner: any OpenAI-compatible chat API. Leave LLM_ENABLED=false to use the free offline planner. ---
LLM_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
# Every call counts, including failed ones. There are no automatic retries.
LLM_HOURLY_CALL_CAP=60
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=45
# false skips the model thinking step (Qwen: enable_thinking=false): about 4 s per plan (median 3.7 s) instead of 7-60 s
LLM_THINKING=true

# --- Real places (finding restaurants and booking a table): each source answers once its key is set ---
# Amap Web Service key (lbs.amap.com). Ratings, average spend per person, opening hours.
AMAP_KEY=
# Tencent Location Service key (lbs.qq.com), the maps inside WeChat; QQMAP_SK only if the key has signatures turned on.
QQMAP_KEY=
QQMAP_SK=
# OpenStreetMap through Nominatim needs no key (one request a second, as its usage policy asks).
PLACES_OSM=true
NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Service ---
PUBLIC_BASE_URL=http://localhost:8000
# Passkeys are bound to this host name (no scheme, no port). It must match the address people open.
PASSKEY_RP_ID=localhost
SESSION_TTL_HOURS=168
# 32+ random characters each. ADMIN_TOKEN also opens the operator console API.
ADMIN_TOKEN=
IP_HASH_SALT=

# --- Demo ---
DEMO_TOOLS_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=15
