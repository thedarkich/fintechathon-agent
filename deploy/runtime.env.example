# Server-only runtime file: copy to runtime.env, chmod 600, never commit the copy.
PUBLIC_BASE_URL=https://bank.example.org
PASSKEY_RP_ID=bank.example.org
ADMIN_TOKEN=
IP_HASH_SALT=
SESSION_TTL_HOURS=168

LLM_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_VISION_MODEL=
LLM_HOURLY_CALL_CAP=60
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=45
# false skips the model thinking step (Qwen: enable_thinking=false): about 4 s per plan (median 3.7 s) instead of 7-60 s
LLM_THINKING=true

# real places: Amap and Tencent answer once their key is set; OpenStreetMap needs none
AMAP_KEY=
QQMAP_KEY=
QQMAP_SK=
PLACES_OSM=true

DEMO_TOOLS_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=15
