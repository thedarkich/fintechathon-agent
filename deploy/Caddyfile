{$DOMAIN} {
    request_body {
        max_size 6MB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Content-Security-Policy "frame-ancestors 'none'"
        Strict-Transport-Security "max-age=86400"
        -Server
    }
    reverse_proxy api:8000
}
